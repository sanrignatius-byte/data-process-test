  "qc_policy": {
    "strategy": "evidence_localization_only",
    "skip_checks": ["single_element_answer", "weak_reasoning_connector", "anchor_leakage", "yes_no_answer"],
    "apply_checks": ["evidence_node_recall", "evidence_type_coverage"],
    "evidence_node_recall_threshold": 0.5,
    "note": "C-Pool query 不验证 answer 质量，只验证 evidence localization：给定 query，系统能否从文档图中召回 expected_evidence_types 中的至少一类节点（Recall@k）。"
  },
  "usage_notes": {
    "single_doc": "summary / motivation / method / results 四类直接使用，query 保持原文。",
    "multi_doc": "cross_doc 类需要将 [PAPER_B] 和 [DATASET] 替换为实际论文名/数据集名，可由脚本在 hub candidate 枚举阶段自动填充。",
    "paraphrase_expansion": "同一 paraphrase_group 内的多条 query 互为 paraphrase，训练时可视为同义表述。",
    "evidence_localization_baseline": "BM25 + dense retrieval，对每条 query 检索 top-k 段落/图表节点，计算 Recall@{1,5,10} 和 MRR。"
  }
