/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 900
  /ImageMatrix [900 0 0 900 0 0]
  /Width 900
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
