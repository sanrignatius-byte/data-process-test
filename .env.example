# ============================================================
# API Keys & Endpoints
# ============================================================
# 复制本文件为 .env 并填入真实值:
#   cp .env.example .env
#
# 加载方式:
#   Linux/Mac: export $(grep -v '^#' .env | xargs)
#   PowerShell: Get-Content .env | Where-Object { $_ -notmatch '^#' -and $_.Trim() -ne '' } | ForEach-Object { $p = $_ -split '=', 2; [Environment]::SetEnvironmentVariable($p[0], $p[1], 'Process') }
# ============================================================

# ── 公司 API（yunwu.ai / gptplus5 等 OpenAI-compat 代理）──
COMPANY_API_KEY=sk-your-company-key-here
COMPANY_API_URL=https://your-company-api-endpoint/v1/chat/completions

# ── Anthropic 直连（集群/个人使用）──
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ── OpenAI（如需使用 --provider openai）──
# OPENAI_API_KEY=sk-your-openai-key-here

# ── Semantic Scholar（论文下载 snowball 脚本）──
# SEMANTIC_SCHOLAR_API_KEY=your-s2-key-here
